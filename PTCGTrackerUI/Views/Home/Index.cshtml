@{
    ViewData["Title"] = "Home Page";
}

<div class="">
    <h1 class="display-6">Deck Name - V1.0</h1>
    <hr />

    <div class="d-flex w-100 justify-content-around p-2">

        <div class="w-75 mw-75 DeckList">
            <h4 class="">List</h4>

            <div class="d-flex gap-2 flex-wrap DeckListCards">
                @for(int i = 1; i <= 30; i++) {
                    <div style="width: 10%;" class="position-relative DeckListCard">
                        <img src="https://images-wixmp-ed30a86b8c4ca887773594c2.wixmp.com/f/4f7705ec-8c49-4eed-a56e-c21f3985254c/dah43cy-a8e121cb-934a-40f6-97c7-fa2d77130dd5.png/v1/fill/w_759,h_1053/pokemon_card_backside_in_high_resolution_by_atomicmonkeytcg_dah43cy-pre.png?token=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..364HskpTM11MwvEzmMXHqIkEbcA318yjhAaLQ9LsH0E" class="w-100" />
                        <div class="position-absolute bottom-0 end-0 bg-danger d-flex justify-content-center align-items-center" style="width: 2.5rem; height: 2.5rem; border-radius: 50% 0 0 0">
                            <h4 class="p-0 m-0">4</h4>
                        </div>
                        <div class="position-absolute top-100 start-50 bg-white z-3 p-2 border shadow-lg rounded DeckListCardInfo" style="width: 250%">
                            <h6>Card Name</h6>
                            <table class="w-100">
                                <tr>
                                    <td>Set: SetCode</td>
                                    <td>Regulation Mark: H</td>
                                </tr>
                                <tr>
                                    <td>Included in List</td>
                                    <td>4</td>
                                </tr>
                                <tr>
                                    <td>Included in IRL</td>
                                    <td>3</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="w-25">
            <h4 class="">Deck Stats</h4>

            <div class="d-flex flex-column justify-content-around gap-4">

                <div class="text-center">
                    <h1>X.XX</h1>
                    <h2>WL Ratio</h2>
                </div>

                <div class="d-flex flex-column align-items-center gap-1">

                    <div class="text-center d-flex justify-content-around w-100">
                        <div>
                            <h3>X</h3>
                            <h4>Wins</h4>
                        </div>
                        <div>
                            <h3>X</h3>
                            <h4>Losses</h4>
                        </div>
                    </div>

                    <div class="text-center d-flex justify-content-around w-100">
                        <div>
                            <button class="btn bg-success p-2 border rounded-pill">Log Win</button>
                        </div>
                        <div>
                            <button class="btn bg-danger p-2 border rounded-pill">Log Loss</button>
                        </div>
                    </div>

                    <button class="btn p-2 border rounded-pill w-50 m-2">Save Records</button>
                </div>

                
                <div>
                    <h5>Sets Used</h5>

                    <table class="table w-100">
                        <thead>
                            <tr>
                                <th>Set</th>
                                <th>Regulation Mark</th>
                                <th>Card Amount</th>
                            </tr>
                        </thead>
                        <tbody class="text-end">
                            @for (int i = 1; i < 5; i++) {
                                <tr>
                                    <td>Set @i</td>
                                    <td>H</td>
                                    <td>4</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

</div>
